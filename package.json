{
  "name": "@barood-labs/agentdiff",
  "version": "0.2.0",
  "description": "Compare two AI coding-agent sessions side by side. Dual timeline, first-divergence jump, plain-English why, offline HTML + Markdown reports.",
  "type": "module",
  "bin": {
    "agentdiff": "cli/agentdiff.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "cli",
    "src",
    "examples",
    "docs/hero.svg",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-demo.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node cli/agentdiff.mjs compare examples/login-bug/a.jsonl examples/login-bug/b.jsonl --out /tmp/agentdiff-demo.html"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "diff",
    "replay",
    "session",
    "debug",
    "cli",
    "visualization",
    "markdown",
    "debugging",
    "divergence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barood-labs/agentdiff.git"
  },
  "homepage": "https://barood-labs.github.io/agentdiff/",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
